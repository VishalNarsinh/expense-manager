# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=expensemanager
POSTGRES_USER=expense
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/expensemanager
DB_USERNAME=expense
DB_PASSWORD=change_me_locally

# Ed25519 keypair for signing access tokens, as single-line base64.
# Leave both blank in local development and an ephemeral keypair is generated at startup, which
# invalidates every outstanding token on restart. Always set them anywhere else.
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -outform DER | base64 -w0   # TOKEN_PRIVATE_KEY
#   openssl pkey -in private.pem -pubout -outform DER | base64 -w0            # TOKEN_PUBLIC_KEY
TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEY=

# 32-byte base64 key for encrypting TOTP secrets at rest
TOTP_ENCRYPTION_KEY=

# Comma-separated Google OAuth client ids accepted as ID token audiences
GOOGLE_CLIENT_IDS=

# Optional first-run admin. If either is blank, no admin user is seeded.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
